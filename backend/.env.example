# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Paritok (Token-Efficiency Hackathon) — https://paritok.com
# Get an API key at paritok.com -> dashboard -> API keys.
# Calls Paritok's hosted GPU compress endpoint directly per-request — no
# local proxy process to run.
PARITOK_ENABLED=true
PARITOK_API_KEY=pk_live_your-paritok-key
